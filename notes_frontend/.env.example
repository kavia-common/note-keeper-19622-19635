# Example environment variables for the Angular notes_frontend
# This file is for documentation purposes only. Do not commit a real .env with secrets.

# API base URL used by the frontend to reach the backend (notes_database) over REST
# In runtime, ensure index.html loads src/assets/env.js which can set:
#   window.NG_APP_API_BASE_URL = "https://your-backend-host/api";
NG_APP_API_BASE_URL=https://localhost:4001/api
